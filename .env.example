# Copia este archivo como ".env" dentro de la carpeta backend/ y completa los valores.
# NUNCA subas tu archivo .env real a GitHub.

# Cadena de conexión a PostgreSQL.
# Formato: postgresql://usuario:password@host:puerto/nombre_base_datos
DATABASE_URL=postgresql://usuario:password@localhost:5432/salon_db

# Clave secreta para firmar las sesiones (tokens JWT).
# Usa un texto largo y aleatorio, por ejemplo generado con: openssl rand -base64 32
JWT_SECRET=cambia-esto-por-un-texto-secreto-y-largo

# Entorno de ejecución
NODE_ENV=development

# Puerto en el que corre el servidor (Render lo asigna automáticamente en producción)
PORT=3000

# Horario del negocio, usado por la página pública de reserva para calcular
# los horarios disponibles (formato 24h HH:MM)
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=19:00
