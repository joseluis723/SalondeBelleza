# Copia este archivo como ".env" dentro de la carpeta backend/ y completa los
# valores. NUNCA subas tu archivo .env real a GitHub.

# ---------------------------------------------------------------------------
# BASE DE DATOS — Turso (SQLite en la nube, plan gratuito)
# ---------------------------------------------------------------------------
# Se obtienen con:  turso db show mi-salon --url
#                   turso db tokens create mi-salon
TURSO_DATABASE_URL=libsql://mi-salon-tuusuario.turso.io
TURSO_AUTH_TOKEN=pega-aqui-tu-token

# Si dejas las dos variables de arriba vacías, el sistema usa un archivo
# SQLite local en data/salon.db (útil para probar en tu computadora).

# ---------------------------------------------------------------------------
# SEGURIDAD
# ---------------------------------------------------------------------------
# Texto largo y aleatorio. Puedes generarlo con: openssl rand -base64 32
JWT_SECRET=cambia-esto-por-un-texto-secreto-y-largo

# Administrador que se crea automáticamente al arrancar
ADMIN_EMAIL=admin@salon.com
ADMIN_PASSWORD=cambia-esta-contrasena
ADMIN_NAME=Administrador
# Pon RESET_ADMIN_PASSWORD=true una sola vez si olvidaste la contraseña
RESET_ADMIN_PASSWORD=false

# ---------------------------------------------------------------------------
# SERVIDOR
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=19:00

# ---------------------------------------------------------------------------
# CORREO (OPCIONAL) — para avisarle al cliente por email que su cita quedó
# confirmada. Si lo dejas vacío, el sistema igual guarda el aviso y el cliente
# puede verlo con su código de reserva, y tú puedes mandárselo por WhatsApp.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
